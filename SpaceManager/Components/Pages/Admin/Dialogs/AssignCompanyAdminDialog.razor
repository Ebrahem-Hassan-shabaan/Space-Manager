@namespace SpaceManager.Components.Pages.Admin.Dialogs
@inject ICompanyService CompanyService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Info" Class="mr-2" />
            <MudText Typo="Typo.h6">Designate Company Administrator</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Assign or transfer the primary administrator privileges for <strong>@CompanyName</strong>.
            The user will be added to the company and granted the <code>CompanyAdmin</code> role.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                @_errorMessage
            </MudAlert>
        }

        <MudTextField @bind-Value="_email"
                      Label="Administrator Email"
                      Placeholder="employee@corporate.com"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Required="true"
                      Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Info"
                   Variant="Variant.Filled"
                   Disabled="_isSubmitting"
                   OnClick="Submit">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Assigning...</span>
            }
            else
            {
                <span>Set Admin</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int CompanyId { get; set; }

    [Parameter]
    public string CompanyName { get; set; } = string.Empty;

    private string _email = string.Empty;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Email address is required.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var result = await CompanyService.SetCompanyAdminAsync(CompanyId, _email.Trim());
            if (!result.Succeeded)
            {
                _errorMessage = result.Error;
                return;
            }

            Snackbar.Add($"Assigned {_email} as CompanyAdmin for {CompanyName}!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
