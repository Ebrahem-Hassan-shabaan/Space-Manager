<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                        <MudPaper Class="pa-8" Elevation="3">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Large" Class="mb-4" />
                            <MudText Typo="Typo.h5" GutterBottom="true">Access Restricted</MudText>
                            <MudText Typo="Typo.body1" Class="mb-6">
                                You do not have permission to access this page, or you need to sign in first.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login" Class="mr-2">
                                Go to Sign In
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/">
                                Return Home
                            </MudButton>
                        </MudPaper>
                    </MudContainer>
                </NotAuthorized>
                <Authorizing>
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-4">Authenticating session...</MudText>
                    </MudContainer>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                    <MudPaper Class="pa-8" Elevation="3">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large" Class="mb-4" />
                        <MudText Typo="Typo.h4" GutterBottom="true">404 - Page Not Found</MudText>
                        <MudText Typo="Typo.body1" Class="mb-6">
                            Sorry, there's nothing at this address.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
                            Return to SpaceManager Home
                        </MudButton>
                    </MudPaper>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
