@namespace SpaceManager.Components.Pages.Auth.Dialogs
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject ICompanyService CompanyService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">Account Profile</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_user != null)
        {
            <!-- User Header -->
            <div class="d-flex align-center gap-4 mb-6">
                <MudAvatar Color="Color.Primary" Size="Size.Large" Style="height: 64px; width: 64px; font-size: 1.5rem;">
                    @(string.IsNullOrWhiteSpace(_user.FullName) ? "?" : _user.FullName[0].ToString().ToUpper())
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_user.FullName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_user.Email</MudText>
                    <div class="mt-1">
                        @if (_roles.Contains("Admin"))
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">System Administrator</MudChip>
                        }
                        else if (_roles.Contains("CompanyAdmin"))
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Company Administrator</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">Platform Member</MudChip>
                        }
                    </div>
                </div>
            </div>

            <!-- Details List (Only shown if affiliated with a company) -->
            @if (_company != null)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4 rounded-lg">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Color="Color.Primary">
                        Corporate Affiliation
                    </MudText>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Company Name:</MudText>
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@_company.Name</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tax / Reg #:</MudText>
                            <MudText Typo="Typo.body2">@_company.TaxRegistrationNumber</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Billing Address:</MudText>
                            <MudText Typo="Typo.body2" Class="text-right">@_company.BillingAddress</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Contact Email:</MudText>
                            <MudText Typo="Typo.body2">@_company.ContactEmail</MudText>
                        </div>
                    </div>
                </MudPaper>
            }

            <!-- Metadata -->
            <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Color="Color.Primary">
                    Account Details
                </MudText>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Account ID:</MudText>
                        <MudText Typo="Typo.caption" Class="font-monospace">@_user.Id</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Member Since:</MudText>
                        <MudText Typo="Typo.body2">@_user.RegisteredAt.ToString("MMMM dd, yyyy")</MudText>
                    </div>
                </div>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Unable to load profile data.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ApplicationUser? _user;
    private CompanyResponseDto? _company;
    private IList<string> _roles = new List<string>();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateTask;
            var caller = authState.User.GetUserContext();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                _user = await UserManager.FindByIdAsync(userId);
                if (_user != null)
                {
                    _roles = await UserManager.GetRolesAsync(_user);
                    if (_user.CompanyId.HasValue)
                    {
                        var companyResult = await CompanyService.GetByIdAsync(_user.CompanyId.Value, caller);
                        _company = companyResult.Succeeded ? companyResult.Data : null;
                    }
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Close() => MudDialog.Close();
}

